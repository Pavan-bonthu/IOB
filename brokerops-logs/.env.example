# Copy this file to .env and edit before starting the server.

# Port the app listens on
PORT=4000

# Base folder on THIS Linux server where per-ticket log folders are created.
# Each ticket gets its own subfolder here, e.g. /else/TCK-1023/
LOGS_BASE_PATH=/else

# Where the tickets database (JSON file) is stored.
# Keep this inside LOGS_BASE_PATH so everything lives together on the server.
DATA_FILE=/else/_tickets-db.json

# Random long string used to sign session cookies. Change this to your own
# random value before going live (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "true" once the app is served over https (recommended: put nginx
# with a TLS cert in front of this app). Leave "false" for plain http.
COOKIE_SECURE=false
